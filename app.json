{
  "expo": {
    "name": "Guvnor",
    "slug": "RoundManagerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roundmanagerapp",
    "userInterfaceStyle": "automatic",
  "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guvnor.roundmanagerapp",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Guvnor uses the camera to attach photos to quotes and jobs.",
        "NSPhotoLibraryUsageDescription": "Guvnor uses your photo library so you can attach photos to quotes and jobs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.guvnor.roundmanagerapp",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "publicPath": "/",
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "firebase": {},
      "router": {
        "disableHardwareBack": true
      },
      "eas": {
        "projectId": "fb9540c5-f865-437c-af65-3f7b33779b5a"
      }
    }
  }
}
